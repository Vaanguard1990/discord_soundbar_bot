# ─── Discord (obbligatorie) ──────────────────────────────────────────────
# Token del bot (Developer Portal → Bot → Token)
DISCORD_TOKEN=il_tuo_token
# Application ID e Client Secret (Developer Portal → OAuth2)
CLIENT_ID=il_tuo_client_id
CLIENT_SECRET=il_tuo_client_secret
# ID Discord del proprietario del bot (accesso admin alla web UI)
OWNER_ID=il_tuo_user_id

# ─── Web (obbligatorie) ──────────────────────────────────────────────────
# URL pubblico del pannello, senza slash finale.
# Deve combaciare con il redirect OAuth2 registrato su Discord:
#   <PUBLIC_URL>/api/oauth/callback
PUBLIC_URL=https://tuodominio.duckdns.org

# Stringa lunga e casuale per firmare le sessioni (cambiala!)
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia_questa_stringa_con_qualcosa_di_lungo_e_casuale

# ─── Opzionali ───────────────────────────────────────────────────────────
# Porta HTTP usata quando i certificati SSL non sono presenti (default 3000)
PORT=3000

# Durata sessione in giorni (default 7)
SESSION_DAYS=7

# Nome istanza mostrato nella UI (es. "PROD" o "TEST")
INSTANCE_NAME=

# GitHub Webhook (auto-deploy). Vuoto = webhook disabilitato.
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Poi metti lo stesso valore nel webhook su GitHub
WEBHOOK_SECRET=

# HTTPS (opzionale, lasciali vuoti per HTTP)
# SSL_CERT=/etc/letsencrypt/live/tuodominio.duckdns.org/fullchain.pem
# SSL_KEY=/etc/letsencrypt/live/tuodominio.duckdns.org/privkey.pem
# HTTPS_PORT=443
# Porta del redirect HTTP→HTTPS, "off" per disabilitarlo
# HTTP_REDIRECT_PORT=80
